{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Campus: 启动后端",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Service", "backend"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": {
        "owner": "campus-java",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.+):\\[(\\d+),(\\d+)\\]\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting CampusMentalHealthApplication",
          "endsPattern": "Started CampusMentalHealthApplication"
        }
      },
      "presentation": {"panel": "dedicated", "group": "campus-dev"}
    },
    {
      "label": "Campus: 启动前端",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Service", "frontend"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": {
        "owner": "campus-vite",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:.*127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {"panel": "dedicated", "group": "campus-dev"}
    },
    {
      "label": "Campus: 启动前后端",
      "dependsOn": ["Campus: 启动后端", "Campus: 启动前端"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Campus: 检查与构建",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "Campus: 安装前端锁定依赖",
      "type": "process",
      "command": "npm.cmd",
      "args": ["ci", "--offline=false", "--cache", "../.tools/npm-cache"],
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    },
    {
      "label": "Campus: 格式化 Java",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/format-java.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Campus: 格式化前端",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "format"],
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "problemMatcher": []
    }
  ]
}
